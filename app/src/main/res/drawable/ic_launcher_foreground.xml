    <path android:pathData="M53.5,63.2 L38.0,58.0 L38.0,46.8 L53.5,52.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="46.8"
                android:endX="53.5"
                android:endY="63.2"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FF38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Illuminated StudyVerse Book Wing (Royal Indigo-Violet Gradient) -->
    <path android:pathData="M54.5,63.2 L70.0,58.0 L70.0,46.8 L54.5,52.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54.5"
                android:startY="46.8"
                android:endX="70"
                android:endY="63.2"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF818CF8" />
                <item android:offset="1.0" android:color="#FFC084FC" />
            </gradient>
