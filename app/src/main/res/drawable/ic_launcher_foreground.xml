<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Orbital Aura Ring (Strictly inside 66dp safe zone: radius 31 around 54,54) -->
    <path
        android:pathData="M54,23 A31,31 0 1,1 53.99,23 Z"
        android:strokeWidth="1.9"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="0.45" android:color="#FF38BDF8" />
                <item android:offset="0.75" android:color="#FF818CF8" />
                <item android:offset="1.0" android:color="#FFC084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3D Gyroscopic Tilted Orbital Ellipse 1 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="28">
        <path
            android:pathData="M24,54 A30,11.5 0 1,0 84,54 A30,11.5 0 1,0 24,54 Z"
            android:strokeWidth="1.1"
            android:strokeColor="#7800E5FF"
            android:fillColor="#00000000" />
    </group>

    <!-- 3D Gyroscopic Tilted Orbital Ellipse 2 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-32">
        <path
            android:pathData="M24,54 A30,11.5 0 1,0 84,54 A30,11.5 0 1,0 24,54 Z"
            android:strokeWidth="1.1"
            android:strokeColor="#78C084FC"
            android:fillColor="#00000000" />
    </group>

    <!-- 3D Obsidian & Liquid-Glass Core Medallion Disc (radius 25.5) -->
    <path
        android:pathData="M54,28.5 A25.5,25.5 0 1,1 53.99,28.5 Z"
        android:strokeWidth="1.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="26"
                android:type="radial">
                <item android:offset="0.0" android:color="#FF192542" />
                <item android:offset="0.65" android:color="#FF0B1120" />
                <item android:offset="1.0" android:color="#FF050811" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#B3FFFFFF" />
                <item android:offset="0.4" android:color="#9900E5FF" />
                <item android:offset="1.0" android:color="#99A855F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-Left Curved Glass Specular Lens Highlight -->
    <path
        android:pathData="M34,45 A22,22 0 0,1 66,33.5"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="33"
                android:endX="66"
                android:endY="45"
                android:type="linear">
                <item android:offset="0.0" android:color="#80FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lower Left Secondary Book Page Accent -->
    <path
        android:fillColor="#6600E5FF"
        android:pathData="M53.4,66.2 L39.2,61.6 L39.2,59.4 L53.4,64.0 Z" />

    <!-- Lower Right Secondary Book Page Accent -->
    <path
        android:fillColor="#66C084FC"
        android:pathData="M54.6,66.2 L68.8,61.6 L68.8,59.4 L54.6,64.0 Z" />

