    </path>

    <!-- Levitating Diamond Knowledge Prism above the Book Spine -->
    <path android:pathData="M54,35.2 L60.2,42.2 L54,49.2 L47.8,42.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="47.8"
                android:startY="35.2"
                android:endX="60.2"
                android:endY="49.2"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.5" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FFC084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Bright Core Facet of Knowledge Prism -->
    <path
        android:fillColor="#B3FFFFFF"
        android:pathData="M54,37.4 L57.4,42.2 L54,45.2 L50.6,42.2 Z" />

    <!-- Orbiting Photon Satellites -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M29.5,39.5 A2.0,2.0 0 1,1 29.49,39.5 Z" />
    <path
        android:fillColor="#FF00E5FF"
        android:pathData="M78.5,39.5 A1.8,1.8 0 1,1 78.49,39.5 Z" />
</vector>
